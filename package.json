{
  "name": "mi-lab",
  "productName": "Mi-lab",
  "private": true,
  "version": "1.0.1",
  "description": "Control de inventario de reactivos de laboratorio clínico",
  "author": "Mi-lab",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "desktopName": "mi-lab.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_DEMO_DATA=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "perf": "PERF=1 vitest run",
    "build:electron": "tsc -p electron/tsconfig.build.json && node scripts/commonjs-marker.mjs",
    "build:desktop": "tsc -b && vite build --outDir dist-desktop --emptyOutDir && pnpm run build:electron",
    "desktop": "pnpm run build:desktop && electron .",
    "dist:win": "pnpm run build:desktop && electron-builder --win --publish never",
    "dist:linux": "pnpm run build:desktop && electron-builder --linux --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "write-excel-file": "4.1.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
